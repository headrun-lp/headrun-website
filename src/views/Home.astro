---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n/ui';
import { href } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} dark>
  <section class="relative flex min-h-[100svh] items-center overflow-hidden text-white">
    <div class="hero-bg" aria-hidden="true">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
      <div class="blob b3"></div>
      <div class="grid"></div>
      <div class="vignette"></div>
      <div class="grain"></div>
    </div>
    <div class="relative mx-auto w-full max-w-6xl px-4 py-32 sm:px-6">
      <h1 class="font-display text-[clamp(1.85rem,8vw,5.5rem)] font-black leading-[0.95] tracking-tight" set:html={ui.home.h1[lang]} />
      <a href={href(lang, '/contact')} class="group mt-10 inline-flex items-center gap-3 rounded-full bg-white px-7 py-4 font-display text-lg font-bold text-ink shadow-[0_10px_40px_-10px_rgba(255,106,43,.7)] transition hover:-translate-y-0.5 hover:shadow-[0_16px_50px_-10px_rgba(124,92,255,.8)]">
        {ui.home.cta[lang]}
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </section>
</Base>
