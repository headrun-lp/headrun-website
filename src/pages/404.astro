---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
---
<Base lang="en" title={ui.notFound.title.en}>
  <section class="mx-auto max-w-6xl px-4 py-32 text-center sm:px-6">
    <p class="font-display text-8xl font-black text-gradient">404</p>
    <h1 class="mt-4 font-display text-3xl font-extrabold">{ui.notFound.title.en} · {ui.notFound.title.el}</h1>
    <p class="mt-6 space-x-4"><a href="/" class="underline">{ui.notFound.back.en}</a><a href="/el/" class="underline">{ui.notFound.back.el}</a></p>
  </section>
</Base>
