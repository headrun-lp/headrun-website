---
import type { Lang, T } from '../i18n/ui';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; images: { src: string; alt: T; fit?: 'contain' }[] }
const { lang, images } = Astro.props;
---
<div class="carousel relative" data-carousel>
  <div class="carousel-track flex overflow-x-auto overflow-y-hidden rounded-3xl bg-ink" data-track>
    {images.map((img, i) => (
      <figure class="relative overflow-hidden aspect-[4/3] w-full shrink-0 sm:aspect-[16/9]">
        {img.fit === 'contain' && <img src={img.src} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-2xl" />}
        <img src={img.src} alt={img.alt[lang]} class:list={['relative h-full w-full', img.fit === 'contain' ? 'object-contain' : 'object-cover']} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      </figure>
    ))}
  </div>
  {images.length > 1 && (
    <>
      <button type="button" data-prev aria-label={ui.event.prev[lang]} class="absolute left-3 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/85 text-ink shadow-lg backdrop-blur transition hover:bg-white">&#8592;</button>
      <button type="button" data-next aria-label={ui.event.next[lang]} class="absolute right-3 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/85 text-ink shadow-lg backdrop-blur transition hover:bg-white">&#8594;</button>
      <div class="mt-4 flex justify-center gap-2" data-dots>
        {images.map((_, i) => (
          <button type="button" aria-label={`${i + 1} / ${images.length}`} class="h-2 w-2 rounded-full bg-ink/25 transition-all aria-[current=true]:w-6 aria-[current=true]:bg-ember" data-dot={i}></button>
        ))}
      </div>
    </>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const count = track.children.length;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + count) % count) * track.clientWidth, behavior: 'smooth' });
    const sync = () => dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index())));
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index() - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(index() - 1);
      if (e.key === 'ArrowRight') go(index() + 1);
    });
    sync();
  });
</script>
