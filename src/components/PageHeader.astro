---
interface Props { title: string; lead?: string; eyebrow?: string }
const { title, lead, eyebrow } = Astro.props;
---
<section class="relative overflow-hidden bg-ink text-white">
  <div class="hero-bg opacity-60" aria-hidden="true">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="grid"></div>
  </div>
  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-white/60">{eyebrow}</p>}
    <h1 class="font-display text-3xl font-black leading-tight tracking-tight sm:text-5xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg text-white/75">{lead}</p>}
  </div>
</section>
